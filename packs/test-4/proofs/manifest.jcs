n. The texts of the tasks and of the answers are not published, except the tasks of the public samples.","The ledger entry lists the reviewer models configured on the platform; none was called in this test (judgements: 0).","NEO AI ran the test on its own platform. No external party has supervised, reproduced or audited it."],"manifest_version":1,"metrics":{"known_answers":{"outcome":{"conditions":[{"id":"cost","lowest_reference_cost_per_success_micro_usd":42598.292929292926,"met":true,"reduction":0.38317298720416304,"required_reduction":0.3,"subject_cost_per_success_micro_usd":26275.777777777777},{"gap_points":0,"highest_reference_exact_rate":1,"id":"accuracy_guard","max_gap_points":7,"met":true,"subject_exact_rate":1}],"result":"met"},"published":{"systems":{"model:model:anthropic/claude/claude-opus-5-5@2026-10-11":{"answers":99,"by_class":{"code":{"answers":27,"exact":27},"data":{"answers":36,"exact":36},"reasoning":{"answers":36,"exact":36}},"completed":99,"cost_per_success_micro_usd":42598.292929292926,"exact":99,"exact_rate":1,"mean_cost_micro_usd":42598.292929292926,"median_cost_micro_usd":36560,"median_total_ms":8913,"total_cost_micro_usd":4217231},"model:model:openai/gpt/gpt-5.5@2026-10-11":{"answers":99,"by_class":{"code":{"answers":27,"exact":27},"data":{"answers":36,"exact":36},"reasoning":{"answers":36,"exact":36}},"completed":99,"cost_per_success_micro_usd":63097.85858585859,"exact":99,"exact_rate":1,"mean_cost_micro_usd":63097.85858585859,"median_cost_micro_usd":62848,"median_total_ms":12073,"total_cost_micro_usd":6246688},"profile:auto":{"answers":99,"by_class":{"code":{"answers":27,"exact":27},"data":{"answers":36,"exact":36},"reasoning":{"answers":36,"exact":36}},"completed":99,"cost_per_success_micro_usd":26275.777777777777,"exact":99,"exact_rate":1,"mean_cost_micro_usd":26275.777777777777,"median_cost_micro_usd":2541,"median_total_ms":10889,"total_cost_micro_usd":2601302},"profile:auto.economy":{"answers":99,"by_class":{"code":{"answers":27,"exac